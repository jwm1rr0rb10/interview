# ===== Блокировка на одном Redis: SET NX PX + токен владельца =====
redis> SET lock:invoice:77 token-a NX PX 10000
OK
redis[B]> SET lock:invoice:77 token-b NX PX 10000
(nil)
# Снимать только свою блокировку: сравнение и удаление — одной атомарной командой (Redis 8.4)
redis[B]> DELEX lock:invoice:77 IFEQ token-b
(integer) 0
redis> DELEX lock:invoice:77 IFEQ token-a
(integer) 1
redis[B]> SET lock:invoice:77 token-b NX PX 10000
OK

# Продление блокировки владельцем (heartbeat) — тоже только своей
# --- скрипт $extend (Lua) ---
if redis.call('GET', KEYS[1]) == ARGV[1] then
  return redis.call('PEXPIRE', KEYS[1], ARGV[2])
end
return 0
# --- конец скрипта ---
redis> EVAL $extend 1 lock:invoice:77 token-a 30000
(integer) 0
redis[B]> EVAL $extend 1 lock:invoice:77 token-b 30000
(integer) 1

# Fencing token: монотонный номер выдаётся вместе с блокировкой,
# хранилище отвергает запись со старым номером
redis> INCR fence:invoice:77
(integer) 1

# ===== Ограничение частоты: фиксированное окно =====
# Ключ на окно (минута 12:00), лимит 3 запроса
redis> INCREX rl:fixed:user42:202611061200 BYINT 1 UBOUND 3 EX 60
1) (integer) 1
2) (integer) 1
redis> INCREX rl:fixed:user42:202611061200 BYINT 1 UBOUND 3 EX 60
1) (integer) 2
2) (integer) 1
redis> INCREX rl:fixed:user42:202611061200 BYINT 1 UBOUND 3 EX 60
1) (integer) 3
2) (integer) 1
redis> INCREX rl:fixed:user42:202611061200 BYINT 1 UBOUND 3 EX 60
1) (integer) 3
2) (integer) 0

# ===== Скользящее окно на сортированном множестве =====
# --- скрипт $sliding (Lua) ---
-- KEYS[1] ключ; ARGV: now_ms, window_ms, limit, request_id
local now, window, limit = tonumber(ARGV[1]), tonumber(ARGV[2]), tonumber(ARGV[3])
redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', now - window)
if redis.call('ZCARD', KEYS[1]) >= limit then
  return 0
end
redis.call('ZADD', KEYS[1], now, ARGV[4])
redis.call('PEXPIRE', KEYS[1], window)
return 1
# --- конец скрипта ---
redis> EVAL $sliding 1 rl:slide:user42 1000000 60000 2 r1
(integer) 1
redis> EVAL $sliding 1 rl:slide:user42 1010000 60000 2 r2
(integer) 1
redis> EVAL $sliding 1 rl:slide:user42 1020000 60000 2 r3
(integer) 0
# через 55 секунд первый запрос выпал из окна
redis> EVAL $sliding 1 rl:slide:user42 1061000 60000 2 r4
(integer) 1
redis> ZRANGE rl:slide:user42 0 -1
1) "r2"
2) "r4"

# ===== Токен-бакет: всплеск до capacity, затем rate токенов в секунду =====
# --- скрипт $bucket (Lua) ---
-- KEYS[1]; ARGV: now_ms, rate_per_sec, capacity, cost
local now, rate, cap, cost = tonumber(ARGV[1]), tonumber(ARGV[2]), tonumber(ARGV[3]), tonumber(ARGV[4])
local b = redis.call('HMGET', KEYS[1], 'tokens', 'ts')
local tokens = tonumber(b[1]) or cap
local ts = tonumber(b[2]) or now
tokens = math.min(cap, tokens + (now - ts) / 1000 * rate)
local allowed = 0
if tokens >= cost then
  tokens = tokens - cost
  allowed = 1
end
redis.call('HSET', KEYS[1], 'tokens', tokens, 'ts', now)
redis.call('PEXPIRE', KEYS[1], math.ceil(cap / rate * 1000))
return {allowed, math.floor(tokens)}
# --- конец скрипта ---
redis> EVAL $bucket 1 tb:user42 0 1 3 1
1) (integer) 1
2) (integer) 2
redis> EVAL $bucket 1 tb:user42 0 1 3 1
1) (integer) 1
2) (integer) 1
redis> EVAL $bucket 1 tb:user42 0 1 3 1
1) (integer) 1
2) (integer) 0
redis> EVAL $bucket 1 tb:user42 0 1 3 1
1) (integer) 0
2) (integer) 0
# прошло 2 секунды — накопилось 2 токена
redis> EVAL $bucket 1 tb:user42 2000 1 3 1
1) (integer) 1
2) (integer) 1

# ===== Семафор: не больше 2 одновременных выгрузок =====
# --- скрипт $semaphore (Lua) ---
-- KEYS[1]; ARGV: now_ms, ttl_ms, limit, holder
redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', tonumber(ARGV[1]) - tonumber(ARGV[2]))
if redis.call('ZCARD', KEYS[1]) < tonumber(ARGV[3]) then
  redis.call('ZADD', KEYS[1], ARGV[1], ARGV[4])
  return 1
end
return 0
# --- конец скрипта ---
redis> EVAL $semaphore 1 sem:export 1000 30000 2 job-1
(integer) 1
redis> EVAL $semaphore 1 sem:export 1001 30000 2 job-2
(integer) 1
redis> EVAL $semaphore 1 sem:export 1002 30000 2 job-3
(integer) 0
redis> ZREM sem:export job-1
(integer) 1
redis> EVAL $semaphore 1 sem:export 1003 30000 2 job-3
(integer) 1
